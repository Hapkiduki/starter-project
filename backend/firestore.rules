rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /community_articles/{articleId} {
      // Anyone (including unauthenticated users) may read community articles.
      allow read: if true;

      // Only authenticated users may create; authorId must match their UID.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;

      // Only the article owner may update or delete.
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }
  }
}